{
  "name": "@malloyyo/server",
  "version": "0.2.31",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/build-dashboard-vendor.mjs",
    "dashboard-vendor": "node scripts/build-dashboard-vendor.mjs",
    "malloy-update": "node scripts/malloy-update.mjs",
    "preflight": "bash scripts/preflight.sh",
    "build": "npm run build -w packages/mcp-engine && node scripts/build-dashboard-vendor.mjs && next build",
    "vercel-build": "tsx scripts/run-boot-migrations.ts && npm run build",
    "start": "next start",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "e2e": "tsx scripts/e2e.ts",
    "test:migrate": "bash scripts/migrate-test.sh",
    "test": "tsx --test 'src/lib/*.test.ts' 'src/lib/**/*.test.ts'",
    "test:hosted": "bash scripts/hosted-test.sh",
    "smoke:telemetry": "tsx scripts/telemetry-smoke.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@duckdb/node-api": "1.4.4-r.1",
    "@malloydata/db-bigquery": "^0.0.431",
    "@malloydata/db-duckdb": "^0.0.431",
    "@malloydata/db-mysql": "^0.0.431",
    "@malloydata/db-postgres": "^0.0.431",
    "@malloydata/db-snowflake": "^0.0.431",
    "@malloydata/db-trino": "^0.0.431",
    "@malloydata/malloy": "^0.0.431",
    "@malloydata/malloy-filter": "^0.0.431",
    "@malloydata/render": "^0.0.431",
    "@malloyyo/mcp-engine": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@uiw/react-codemirror": "^4.25.9",
    "ai": "^6.0.177",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.24.0",
    "lucide-react": "^1.28.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "posthog-node": "5.21.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vega": "^5.33.1",
    "vega-interpreter": "^2.2.1",
    "vega-lite": "^5.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}

// This repository's own Codespace / Dev Container.
//
// It runs the SAME published image that model repos use (built from the
// Dockerfile beside this file — see docs/devcontainer.md), rather than building
// that Dockerfile locally: building it here would cost every codespace several
// minutes and, worse, would let this repo drift from what everyone else gets.
// A change to the Dockerfile reaches this file's codespaces once CI publishes
// it, which is the same path a model repo is on.
//
// The extensions, the dashboard ports and the remote user are NOT repeated
// here — they ride along in the image's `devcontainer.metadata` label. What is
// below is only what is specific to developing Malloyyo itself.
{
  "name": "Malloyyo",
  "image": "ghcr.io/malloydata/malloyyo-devcontainer:latest",

  // The server's test suites stand up an ephemeral Postgres: `npm run
  // test:hosted` and `npm run test:migrate` both want a Docker daemon (the
  // hosted suite can fall back to a local initdb, the migration suite cannot).
  // That is a cost only this repo pays, so it is a feature here and not a layer
  // in the shared image.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next.js dev server" }
  },

  // Workspace deps, not global ones. Leaves the tree ready for `npm run dev`,
  // `bash scripts/preflight.sh` and the CLI's own build.
  "postCreateCommand": "npm ci",

  "remoteEnv": {
    // `npm run dev` against a real instance's database would otherwise be a
    // surprise; boot migrations stay off in dev (bootMigrationsEnabled()), and
    // saying so explicitly keeps it true if that default ever moves.
    "RUN_MIGRATIONS_ON_BOOT": "0"
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  }
}
